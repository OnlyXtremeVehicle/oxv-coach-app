{
  "name": "oxv-mirror-app",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:rls": "jest src/__tests__/rls --runInBand",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\" \"app/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\" \"app/**/*.{ts,tsx,json}\"",
    "doctrine": "npx --yes tsx scripts/check-doctrine.ts",
    "doctrine:a11y": "npx --yes tsx scripts/check-accessibility.ts --strict",
    "build:ios:dev": "eas build --platform ios --profile development",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:prod": "eas build --platform ios --profile production",
    "build:android:dev": "eas build --platform android --profile development",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:prod": "eas build --platform android --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/michroma": "^0.4.2",
    "@expo-google-fonts/syncopate": "^0.4.1",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/native": "^7.0.14",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.4.18",
    "@supabase/supabase-js": "^2.45.4",
    "buffer": "^6.0.3",
    "expo": "^55.0.28",
    "expo-apple-authentication": "~55.0.15",
    "expo-application": "~55.0.17",
    "expo-asset": "~55.0.18",
    "expo-audio": "~55.0.16",
    "expo-blur": "~55.0.16",
    "expo-camera": "~55.0.21",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-device": "~55.0.19",
    "expo-file-system": "~55.0.24",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.16",
    "expo-image": "~55.0.11",
    "expo-image-manipulator": "~55.0.19",
    "expo-image-picker": "~55.0.22",
    "expo-keep-awake": "~55.0.8",
    "expo-linear-gradient": "~55.0.16",
    "expo-linking": "~55.0.16",
    "expo-local-authentication": "~55.0.16",
    "expo-localization": "~55.0.17",
    "expo-location": "~55.1.12",
    "expo-notifications": "~55.0.25",
    "expo-print": "~55.0.17",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-sharing": "~55.0.22",
    "expo-splash-screen": "~55.0.23",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.26",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-ble-plx": "^3.2.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-health": "^1.19.0",
    "react-native-maps": "1.27.2",
    "react-native-mmkv": "~3.3.3",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-permissions": "^4.1.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-toast-message": "^2.2.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-view-shot": "~4.0.3",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~55.0.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "~3.8.3",
    "sharp": "^0.34.5",
    "ts-jest": "^29.4.11",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react-native-health": {
      "@expo/config-plugins": "~10.1.1"
    },
    "react-dom": "19.2.0"
  }
}
