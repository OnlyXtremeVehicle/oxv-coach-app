{
  "expo": {
    "name": "OXV",
    "slug": "oxv-app",
    "version": "1.0.0",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d168d639-22e2-4190-a9ea-cc6a31e3acaa",
      "enabled": true,
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "oxv",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.oxvehicle.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "OXV utilise l'appareil photo pour votre photo de profil et la lecture des documents.",
        "NSPhotoLibraryUsageDescription": "OXV utilise vos photos pour votre profil et vos véhicules.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": false
        }
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "package": "fr.oxvehicle.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050505"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "./plugins/withoutHealthRecords.js",
      "./plugins/texteReseauLocal.js",
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Votre position sert à détecter votre arrivée au circuit, à enregistrer un lieu ou un tracé que vous créez, et au scan Bluetooth qu'iOS exige. Aucun suivi en arrière-plan.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Le coach enregistre une note vocale pour vous, après votre séance. Rien n'est capté pendant que vous roulez.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "bluetoothAlwaysPermission": "OXV se connecte en Bluetooth à votre boîtier RaceBox, et à votre ceinture cardiaque si vous en portez une."
        }
      ],
      [
        "react-native-permissions",
        {
          "iosPermissions": ["Bluetooth"]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OXV utilise vos photos pour votre profil et vos véhicules.",
          "cameraPermission": "OXV utilise l'appareil photo pour votre profil et vos documents."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "OXV utilise l'appareil photo pour scanner les codes de présence aux événements."
        }
      ],
      [
        "react-native-health",
        {
          "healthSharePermission": "OXV lit votre fréquence cardiaque enregistrée pendant vos roulages, pour vous la restituer après la séance. Rien n'est lu sans votre consentement, et vous pouvez le retirer à tout moment.",
          "healthUpdatePermission": "OXV n'écrit rien dans votre dossier de santé.",
          "isClinicalDataEnabled": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "OXV utilise Face ID pour sécuriser votre compte."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C8102E",
          "defaultChannel": "debrief",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d168d639-22e2-4190-a9ea-cc6a31e3acaa"
      }
    },
    "owner": "oxv"
  }
}
