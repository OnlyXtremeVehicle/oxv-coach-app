# ============================================================
# OXV Mirror — .gitignore
# ============================================================

# Supabase CLI local temp (project-ref, versions) — non sensible mais inutile en git
supabase/.temp/

# ----------------------------------------------------------------
# SECRETS — NE JAMAIS COMMITER
# ----------------------------------------------------------------
.env
.env.local
.env.production
.env.development
.env.test
.env.test.local
# Dossiers de secrets locaux (clés Apple, identifiants) — propres à chaque poste
secret/
secrets/
*.pem
*.key
*.p8
*.p12
serviceAccountKey.json

# Credentials Apple et Google
#
# D-2 — CES GARDES ÉTAIENT ANCRÉES À DES CHEMINS QUI N'EXISTENT PAS.
#
# Elles étaient écrites `ios/*.mobileprovision` et `android/app/*.keystore`.
# Or ce projet ne contient NI `ios/` NI `android/` : le natif est généré au
# build par prebuild. Un fichier de signature déposé ailleurs — à la racine,
# dans un dossier de travail, à côté d'un script — n'était donc pas couvert.
#
# Vérifié plutôt que supposé : avant correction, `git check-ignore` laissait
# passer les quatre. Rien n'a fuité (aucun fichier de ce type n'est suivi, ni
# ne l'a jamais été dans l'historique), mais la garde ne tenait pas.
#
# Les motifs sont désormais GLOBAUX : ils valent où que le fichier atterrisse.
*.mobileprovision
*.cer
*.keystore
*.jks
google-services.json
GoogleService-Info.plist

# ----------------------------------------------------------------
# REACT NATIVE / EXPO
# ----------------------------------------------------------------
node_modules/
.expo/
.expo-shared/
dist/
web-build/
*.jks
*.aab
*.apk
*.ipa

# Build artifacts
ios/build/
ios/Pods/
ios/Podfile.lock
android/build/
android/app/build/
android/.gradle/
android/local.properties

# ----------------------------------------------------------------
# TYPESCRIPT / JAVASCRIPT
# ----------------------------------------------------------------
*.tsbuildinfo
.tsc-cache/
coverage/
.nyc_output/

# ----------------------------------------------------------------
# IDE & ÉDITEURS
# ----------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ----------------------------------------------------------------
# LOGS
# ----------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ----------------------------------------------------------------
# TESTS
# ----------------------------------------------------------------
coverage/
.jest-cache/
jest_html_reporters.html

# ----------------------------------------------------------------
# DONNÉES DE TEST LOCAL (à ne pas commiter)
# ----------------------------------------------------------------
test-data/
local-storage/

# Enregistrements UBX privés et volumineux : exclus par défaut...
*.ubx
local-recordings/
# ...sauf les fixtures de test reproductibles
!test-fixtures/*.ubx

